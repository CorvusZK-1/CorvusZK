{
  "name": "CorvusZK live server (Codespaces fallback)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "features": { "ghcr.io/devcontainers/features/docker-in-docker:2": {} },
  "forwardPorts": [8790],
  "portsAttributes": { "8790": { "label": "live server", "visibility": "public" } },
  "postCreateCommand": "npm ci && (cd midnight && npm ci) && npm run build --if-present",
  "postStartCommand": "docker run -d --rm --name proof -p 6300:6300 midnightntwrk/proof-server:9.0.0",
  "remoteEnv": { "MIDNIGHT_NETWORK": "preview", "MN_WALLET_DIR": "/workspaces/wallet", "ALLOWED_ORIGINS": "https://corvuszk.com" }
}
